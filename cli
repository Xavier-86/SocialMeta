# =============================================================================

def cmd_train(args):
    """Training command - unified interface for all algorithms"""
    algo = args.algo.upper()
    env = args.env
    
    if algo == "SVO":
        return train_svo(env, args)
    else:
        return train_standard(algo, env, args)


def train_svo(env, args):
    """Train SVO policies - single angle or batch"""
    if env not in SVO_ENVS:
        print(f"Error: Environment '{env}' not supported by SVO")
        print(f"Supported: {', '.join(SVO_ENVS)}")
        return False
    
    # Determine angles to train
    if args.svo_angles:
        angles = [int(a.strip()) for a in args.svo_angles.split(',')]
    elif args.svo_angle is not None:
        angles = [args.svo_angle]
    else:
        angles = [0, 15, 30, 45, 60, 75, 90]  # Default: all angles
    
    # Map environment name to actual ENV_NAME for config
    env_id_map = {
        "cleanup": "clean_up",
        "coins": "coin_game",
        "coin": "coin_game",
        "mushrooms": "mushrooms",
        "mushroom": "mushrooms",
        "harvest_open": "harvest_common_open",
        "harvest_closed": "harvest_common_closed",
        "harvest_partnership": "harvest_common_partnership",
    }
    env_id = env_id_map.get(env, env)
    
    # Target directory for SVO policies
    svo_env_map = {
        "cleanup": "cleanup",
        "coins": "coin",
        "coin": "coin",
        "mushrooms": "mushroom",
        "mushroom": "mushroom",
        "harvest_open": "harvest_open",
        "harvest_closed": "harvest_closed",
        "harvest_partnership": "harvest_partnership",
    }
    target_env = svo_env_map.get(env, env)
    target_dir = PROJECT_ROOT / "svo-policies" / target_env
    
    # Use generic script
    script = PROJECT_ROOT / "algorithms" / "SVO" / "svo_cnn_generic.py"
    if not script.exists():
        print(f"Error: Generic script not found: {script}")
        return False
    
    print(f"\n{'='*60}")
    print(f"Training SVO policies for {env}")
    print(f"Angles: {angles}")
    print(f"Target: {target_dir}")
    print(f"Script: {script}")
    print(f"{'='*60}\n")
    
    success_count = 0
    for angle in angles:
        print(f"\n>>> Training SVO angle={angle}...")
        
        cmd = [
            "python3", str(script),
            f"TUNE=False",
            f"SEED={args.seed}",
            f"WANDB_MODE={args.wandb_mode}",
            f"ENV_KWARGS.svo_ideal_angle_degrees={angle}",
        ]
        
        if args.num_envs:
            cmd.append(f"NUM_ENVS={args.num_envs}")
        if args.total_timesteps is not None:
            cmd.append(f"TOTAL_TIMESTEPS={int(args.total_timesteps)}")
        
        env_vars = os.environ.copy()
        env_vars["PYTHONPATH"] = f"{PROJECT_ROOT}:{env_vars.get('PYTHONPATH', '')}"
        
        result = subprocess.run(cmd, cwd=PROJECT_ROOT, env=env_vars)
        
        if result.returncode != 0:
            print(f"!! Training failed for angle={angle}")
            continue
        
        # Find and copy checkpoint
        checkpoint_dir = PROJECT_ROOT / "checkpoints"
        checkpoint_files = sorted(checkpoint_dir.glob(f"{env}_seed{args.seed}_reward_*.pkl"), 
                                   key=lambda x: x.stat().st_mtime, reverse=True)
        
        if checkpoint_files:
            checkpoint = checkpoint_files[0]
            target_dir.mkdir(parents=True, exist_ok=True)
            target_file = target_dir / f"svo_angle_{angle}.pkl"
            
            import shutil
            shutil.copy2(checkpoint, target_file)
            size = target_file.stat().st_size / 1024 / 1024
            print(f"✓ Saved: {target_file.name} ({size:.1f} MB)")
            success_count += 1
        else:
            print(f"!! Checkpoint not found for angle={angle}")
    
    print(f"\n{'='*60}")
    print(f"Completed: {success_count}/{len(angles)} angles")
    print(f"{'='*60}")
    return success_count == len(angles)


def train_standard(algo, env, args):
    """Train standard algorithms (IPPO, MAPPO, RL2, MAML)"""
    if algo not in ALGO_ENV_MAP:
        print(f"Error: Unknown algorithm '{algo}'")
        print(f"Supported: {', '.join(ALGO_ENV_MAP.keys())}")
        return False
    
    algo_config = ALGO_ENV_MAP[algo]
    
    if not validate_env(algo, env, algo_config["envs"]):
        return False
    
    result = find_script(algo, env, algo_config)
    if not result:
        return False
    
    # Handle both single script path and (script_path, config_name) tuple
    if isinstance(result, tuple):
        script_path, config_name = result
    else:
        script_path = result
        config_name = None
    
    cmd = build_training_cmd(script_path, algo, env, args, config_name)
    return run_command(cmd, f"Training {algo} - {env}")


def validate_env(algo, env, supported_envs):
    """Validate environment support"""
    valid_names = set(supported_envs)
    env_variations = {
        "gifts": ["gift", "gifts"],
        "gift": ["gift", "gifts"],
        "coins": ["coins", "coin"],
        "coin": ["coins", "coin"],
        "mushroom": ["mushrooms", "mushroom"],
        "mushrooms": ["mushrooms", "mushroom"],
    }
    
    for variations in env_variations.values():
        if env in variations:
            valid_names.update(variations)
    
    if env not in valid_names:
        print(f"Error: '{env}' not supported by {algo}")
        print(f"Supported: {', '.join(supported_envs)}")
        return False
    return True


def find_script(algo, env, algo_config):
    """Find the appropriate training script"""
    script_prefix = algo_config["script_prefix"]
    algo_path = algo_config["path"]
    
    # For generic algorithms (RL2, MAML), use the generic script with environment-specific config
    if algo in ["RL2", "MAML"]:
        generic_script = PROJECT_ROOT / algo_path / f"{script_prefix}_generic.py"
        if generic_script.exists():
            # Map environment to config name
            config_map = {
                "coop_mining": f"{script_prefix}_coop_mining",
                "cleanup": f"{script_prefix}_cleanup",
                "clean_up": f"{script_prefix}_cleanup",
                "coins": f"{script_prefix}_coins",
                "coin_game": f"{script_prefix}_coins",
                "gift": f"{script_prefix}_gift",
                "mushrooms": f"{script_prefix}_mushrooms",
                "pd_arena": f"{script_prefix}_pd_arena",
            }
            config_name = config_map.get(env, f"{script_prefix}_{env}")
            return generic_script, config_name
    
    env_key = (env, algo)
    env_name = ENV_SCRIPT_MAP.get(env_key, env)
    
    script_name = f"{script_prefix}_{env_name}.py"
    script_path = PROJECT_ROOT / algo_path / script_name
    
    if script_path.exists():
        return script_path
    
    alternatives = [env, env_name, env.replace("_", ""), env_name.replace("_", "")]
    for alt_env in alternatives:
        alt_path = PROJECT_ROOT / algo_path / f"{script_prefix}_{alt_env}.py"
        if alt_path.exists():
            return alt_path
    
    print(f"Error: Script not found for {algo}/{env}")
    print(f"Tried: {script_path}")
    return None


def build_training_cmd(script_path, algo, env, args, config_name=None):
    """Build training command with parameters"""
    cmd = ["python3", str(script_path)]
    
    # For RL2/MAML with Hydra, use --config-name to select environment-specific config
    if algo in ["RL2", "MAML"] and config_name:
        cmd.append(f"--config-name={config_name}")
    
    if args.test:
        total_timesteps = 1000
    elif args.total_timesteps is not None:
        total_timesteps = int(args.total_timesteps)
    else:
        # Use config file default - don't override
        total_timesteps = None
    
    if total_timesteps is not None:
        cmd.append(f"TOTAL_TIMESTEPS={total_timesteps}")
    cmd.append(f"NUM_ENVS={args.num_envs}")
    cmd.append(f"SEED={args.seed}")
    cmd.append(f"WANDB_MODE={args.wandb_mode}")
    cmd.append(f"TUNE={str(args.tune).lower()}")
    
    # Override environment name and teammate policy dir for meta-learning algorithms
    if algo in ["RL2", "MAML"]:
        # Map CLI environment name to actual SocialMeta environment ID
        env_id_map = {
            "cleanup": "clean_up",
            "coins": "coin_game",
            "harvest_common": "harvest_common_open",
            "harvest_common_closed": "harvest_common_closed",
            "harvest_common_partnership": "harvest_common_partnership",
        }
        env_id = env_id_map.get(env, env)
        cmd.append(f"ENV_NAME={env_id}")
        # Map environment name to SVO policy directory name
        svo_env_map = {
            "cleanup": "cleanup",
            "coins": "coin",
            "mushrooms": "mushroom",
            "harvest_common": "harvest_open",
            "harvest_common_closed": "harvest_closed",
            "harvest_common_partnership": "harvest_partnership",
        }
        svo_env = svo_env_map.get(env, env)
        cmd.append(f"TEAMMATE_POLICY_DIR=svo-policies/{svo_env}")
    
    if args.num_steps is not None:
        cmd.append(f"NUM_STEPS={args.num_steps}")
    
    if args.lr is not None:
        lr_key = "OUTER_LR" if algo == "MAML" else "LR"
        cmd.append(f"{lr_key}={args.lr}")
    
    if algo in ["RL2", "MAML"]:
        trial_episodes = args.trial_episodes or ALGO_ENV_MAP[algo]["default_params"].get("TRIAL_EPISODES", 3)
        cmd.append(f"TRIAL_EPISODES={trial_episodes}")
        
        if args.episode_reward_weights is not None:
            reward_weights = args.episode_reward_weights
        else:
            weight = round(1.0 / trial_episodes, 2)
            weights = [weight] * trial_episodes
            weights[-1] = round(1.0 - sum(weights[:-1]), 2)
            reward_weights = str(weights).replace(" ", "")
        cmd.append(f"EPISODE_REWARD_WEIGHTS={reward_weights}")
    
    if algo == "MAML":
        first_order = "true" if args.first_order_maml else "false"
        cmd.append(f"FIRST_ORDER_MAML={first_order}")
    
    return cmd


def run_command(cmd, description=""):
    """Execute command with formatted output"""
    if description:
        print(f"\n{'='*60}")
        print(f"{description}")
        print(f"{'='*60}")
    print(f"$ {' '.join(cmd)}\n")
    
    env = os.environ.copy()
    env["PYTHONPATH"] = f"{PROJECT_ROOT}:{env.get('PYTHONPATH', '')}"
    
    try:
        result = subprocess.run(cmd, cwd=PROJECT_ROOT, env=env)
        return result.returncode == 0
    except KeyboardInterrupt:
        print("\n\nTraining interrupted")
        return False


