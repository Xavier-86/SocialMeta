def cmd_status(args):
    """Display comprehensive training status"""
    print("\n" + "="*60)
    print("SocialMeta Training Status")
    print("="*60)
    
    # SVO Policies
    print("\nSVO Policies (63 total):")
    svo_policies = PROJECT_ROOT / "svo-policies"
    if svo_policies.exists():
        for env_dir in sorted(svo_policies.iterdir()):
            if env_dir.is_dir():
                count = len(list(env_dir.glob("svo_angle_*.pkl")))
                status = "OK" if count == 7 else "Partial" if count > 0 else "Missing"
                print(f"  [{status:7s}] {env_dir.name:20s}: {count}/7")
    
    # Checkpoints
    print("\nModel Checkpoints:")
    checkpoints = PROJECT_ROOT / "checkpoints"
    if checkpoints.exists():
        for subdir in ["individual", "maml", "rl2", "rl2_cnn", "ippo", "mappo"]:
            subpath = checkpoints / subdir
            if subpath.exists():
                count = len(list(subpath.glob("*.pkl")))
                if count > 0:
                    print(f"  - {subdir:15s}: {count} models")
        root_count = len([f for f in checkpoints.glob("*.pkl") if f.is_file()])
        if root_count:
            print(f"  - {'(root)':15s}: {root_count} models")
    
    # Running processes
    print("\nActive Training Tasks:")
    result = subprocess.run(
        ["pgrep", "-f", "python.*train|train.*py"],
        capture_output=True, text=True
    )
    if result.returncode == 0 and result.stdout.strip():
        lines = result.stdout.strip().split('\n')
        print(f"  {len(lines)} process(es) running")
    else:
        print("  No active training tasks")
    
    print("\n" + "="*60)
    return True


