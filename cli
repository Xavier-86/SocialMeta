def cmd_list(args):
    """List available resources"""
    if args.svo:
        return list_svo_policies()
    elif args.checkpoints:
        return list_checkpoints()
    elif args.algo:
        return list_algo_envs(args.algo)
    else:
        return list_all_algos()


def list_svo_policies():
    """List SVO policy files"""
    print("\nSVO Policies:")
    svo_policies = PROJECT_ROOT / "svo-policies"
    if not svo_policies.exists():
        print("  No SVO policies found")
        return True
    
    for env_dir in sorted(svo_policies.iterdir()):
        if env_dir.is_dir():
            print(f"\n  {env_dir.name}/")
            for f in sorted(env_dir.glob("*.pkl")):
                size = f.stat().st_size / 1024 / 1024
                print(f"    - {f.name:25s} ({size:.1f} MB)")
    return True


def list_checkpoints():
    """List checkpoint files"""
    print("\nCheckpoints:")
    checkpoints = PROJECT_ROOT / "checkpoints"
    if not checkpoints.exists():
        print("  No checkpoints found")
        return True
    
    for f in sorted(checkpoints.rglob("*.pkl")):
        rel_path = f.relative_to(checkpoints)
        size = f.stat().st_size / 1024 / 1024
        print(f"  - {rel_path} ({size:.1f} MB)")
    return True


def list_algo_envs(algo):
    """List environments for specific algorithm"""
    algo = algo.upper()
    if algo not in ALGO_ENV_MAP:
        print(f"Error: Unknown algorithm: {algo}")
        return False
    
    print(f"\n{algo} - Supported Environments:")
    for i, env in enumerate(ALGO_ENV_MAP[algo]["envs"], 1):
        print(f"  {i:2d}. {env}")
    return True


def list_all_algos():
    """List all algorithms and their environment counts"""
    print("\nAvailable Algorithms:")
    print()
    
    for algo, config in ALGO_ENV_MAP.items():
        env_count = len(config["envs"])
        meta_tag = "[Meta]" if algo in ["RL2", "MAML"] else ""
        print(f"  {algo:12s} {meta_tag:6s} {env_count} envs", end="")
        if env_count <= 3:
            print(f"  ({', '.join(config['envs'])})")
        else:
            print(f"  ({', '.join(config['envs'][:3])}...)")
    
    print("\nUse --algo <ALGO> to see full environment list")
    return True


# =============================================================================
# Clean Command
# =============================================================================

def cmd_clean(args):
    """Clean temporary files and caches"""
    print("\nCleaning temporary files...")
    
    cleaned = []
    
    outputs = PROJECT_ROOT / "outputs"
    if outputs.exists():
        import shutil
        count = sum(1 for _ in outputs.rglob("*") if _.is_file())
        if count > 0:
            shutil.rmtree(outputs)
            cleaned.append(f"outputs/ ({count} files)")
    
    wandb = PROJECT_ROOT / "wandb"
    if wandb.exists():
        import shutil
        count = sum(1 for _ in wandb.rglob("*") if _.is_file())
        if count > 100:
            shutil.rmtree(wandb)
            cleaned.append(f"wandb/ ({count} files)")
        elif count > 0:
            print(f"  wandb/ has {count} files, skipped")
    
    if cleaned:
        print("  Cleaned:")
        for item in cleaned:
            print(f"     - {item}")
    else:
        print("  Nothing to clean")
    
    print("\nDone")
    return True


# =============================================================================
# Main Entry Point
# =============================================================================

def main():
    parser = argparse.ArgumentParser(
        description="SocialMeta - Multi-Agent RL for Sequential Social Dilemmas",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  ./cli train --algo IPPO --env coop_mining
  ./cli train --algo IPPO --env coop_mining --num_envs 512 --lr 0.0005
  ./cli train --algo RL2 --env coop_mining --trial_episodes 3
  ./cli train --algo IPPO --env coop_mining --test
  
  # SVO training (generates all 7 angles by default)
  ./cli train --algo SVO --env coop_mining
  ./cli train --algo SVO --env coop_mining --svo_angle 45
  ./cli train --algo SVO --env coop_mining --svo_angles "0,15,30"
  ./cli train --algo SVO --env coop_mining --test  # Quick test (1000 steps)
  
  ./cli status
  ./cli list
  ./cli list --algo IPPO
  ./cli list --svo
  ./cli clean
        """
    )
    
    subparsers = parser.add_subparsers(dest="command", help="Commands")
    
    # Train command
    train_parser = subparsers.add_parser("train", help="Train models")
    train_parser.add_argument("--algo", required=True, choices=list(ALGO_ENV_MAP.keys()),
                             help="Algorithm name")
    train_parser.add_argument("--env", required=True, help="Environment name")
    train_parser.add_argument("--total_timesteps", type=float, default=None,
                             help="Total training steps (default: use config value)")
    train_parser.add_argument("--num_envs", type=int, default=32,
                             help="Parallel environments (default: 32)")
    train_parser.add_argument("--num_steps", type=int, help="Steps per update")
    train_parser.add_argument("--lr", type=float, help="Learning rate")
    train_parser.add_argument("--seed", type=int, default=30, help="Random seed")
    train_parser.add_argument("--trial_episodes", type=int, help="Episodes per trial (RL2/MAML)")
    train_parser.add_argument("--episode_reward_weights", type=str, help="Reward weights")
    train_parser.add_argument("--first_order_maml", action="store_true", help="Use first-order MAML")
    train_parser.add_argument("--wandb_mode", default="disabled",
                             choices=["online", "offline", "disabled"],
                             help="W&B mode (default: disabled)")
    train_parser.add_argument("--tune", action="store_true", help="Enable hyperparameter sweep")
    train_parser.add_argument("--test", action="store_true", help="Quick test mode (1000 steps)")
    train_parser.add_argument("--svo_angle", type=int, help="SVO angle (single, default: 0-90)")
    train_parser.add_argument("--svo_angles", type=str, help="SVO angles, comma-separated (e.g., '0,15,30')")
    
    # Status command
    subparsers.add_parser("status", help="View training status")
    
    # List command
    list_parser = subparsers.add_parser("list", help="List resources")
    list_parser.add_argument("--svo", action="store_true", help="List SVO policies")
    list_parser.add_argument("--checkpoints", action="store_true", help="List checkpoints")
    list_parser.add_argument("--algo", type=str, choices=list(ALGO_ENV_MAP.keys()),
                            help="List environments for algorithm")
    
    # Clean command
    subparsers.add_parser("clean", help="Clean temporary files")
    
    args = parser.parse_args()
    
    if args.command is None:
        parser.print_help()
        return 1
    
    commands = {
        "train": cmd_train,
        "status": cmd_status,
        "list": cmd_list,
        "clean": cmd_clean,
    }
    
    success = commands[args.command](args)
    return 0 if success else 1


if __name__ == "__main__":
    sys.exit(main())
