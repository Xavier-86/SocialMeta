#!/usr/bin/env python3
"""
SocialMeta Unified CLI - Unified training and management tool

Usage:
    socialmeta-cli train --algo SVO --env <env_name> [options]
    socialmeta-cli status
    socialmeta-cli list [--svo | --checkpoints]
    socialmeta-cli clean
"""

import argparse
import subprocess
import sys
import os
from pathlib import Path

# Project root directory
PROJECT_ROOT = Path(__file__).parent.absolute()
os.chdir(PROJECT_ROOT)

# Supported configurations
SVO_ENVS = [
    "cleanup", "coin", "coop_mining", "gift", "mushroom",
    "pd_arena", "harvest_open", "harvest_closed", "harvest_partnership"
]

ALGO_ENVS = {
    "IPPO": ["coop_mining", "cleanup", "coins", "gift", "mushrooms", "pd_arena", 
             "harvest_common", "harvest_common_closed", "harvest_common_partnership", "territory_open"],
    "IPPO_raw": ["coop_mining", "cleanup", "coins", "gift", "mushrooms", "pd_arena",
                 "harvest_common", "harvest_common_closed", "harvest_common_partnership", "territory_open"],
    "MAPPO": ["coop_mining", "cleanup", "coins", "gifts", "mushrooms", "pd_arena",
               "harvest_common", "harvest_common_closed", "harvest_common_partnership", "territory_open"],
    "SVO": SVO_ENVS,
    "RL2": ["coop_mining"],
    "MAML": ["coop_mining"],
}


def run_command(cmd, description=""):
    """Run shell command and display output"""
    if description:
        print(f"\n{'='*50}")
        print(f"{description}")
        print(f"{'='*50}")
    print(f"$ {' '.join(cmd)}")
    result = subprocess.run(cmd, capture_output=False, text=True)
    return result.returncode == 0


def cmd_train(args):
    """Training command"""
    algo = args.algo.upper()
    env = args.env
    
    if algo == "SVO":
        return train_svo(env, args)
    else:
        return train_standard(algo, env, args)


def train_svo(env, args):
    """Train SVO policies"""
    if env not in SVO_ENVS:
        print(f"❌ Error: Environment '{env}' not supported by SVO")
        print(f"Supported environments: {', '.join(SVO_ENVS)}")
        return False
    
    # Use memory-controlled script
    script = PROJECT_ROOT / "train_svo_with_memory_control.sh"
    cmd = ["bash", str(script), "--env", env]
    
    if args.num_envs:
        cmd.extend(["--num-envs", str(args.num_envs)])
    if args.seed:
        cmd.extend(["--seed", str(args.seed)])
    
    return run_command(cmd, f"Training SVO - {env}")


def train_standard(algo, env, args):
    """Train standard algorithms (IPPO, MAPPO, RL2, MAML)"""
    if algo not in ALGO_ENVS:
        print(f"❌ Error: Unknown algorithm '{algo}'")
        print(f"Supported algorithms: {', '.join(ALGO_ENVS.keys())}")
        return False
    
    if env not in ALGO_ENVS[algo]:
        print(f"❌ Error: {algo} does not support environment '{env}'")
        print(f"Supported environments: {', '.join(ALGO_ENVS[algo])}")
        return False
    
    # Build training command
    config_path = f"algorithms/{algo}/config"
    
    # Find corresponding Python script
    script_pattern = f"algorithms/{algo}/{algo.lower()}*_{env.replace('_', '')}*.py"
    import glob
    scripts = glob.glob(script_pattern)
    
    if not scripts:
        print(f"❌ Error: Cannot find training script for {algo}/{env}")
        print(f"Attempted pattern: {script_pattern}")
        return False
    
    script = scripts[0]
    cmd = ["python", script]
    
    # Add parameters
    if args.num_envs:
        cmd.append(f"NUM_ENVS={args.num_envs}")
    if args.seed:
        cmd.append(f"SEED={args.seed}")
    if not args.wandb:
        cmd.append("WANDB_MODE=disabled")
    if args.test:
        cmd.append("TOTAL_TIMESTEPS=10000")
    
    return run_command(cmd, f"Training {algo} - {env}")


def cmd_status(args):
    """Display training status"""
    print("\n" + "="*60)
    print("SocialMeta Training Status")
    print("="*60)
    
    # SVO policies statistics
    print("\n📊 SVO Policies:")
    svo_policies = PROJECT_ROOT / "svo-policies"
    if svo_policies.exists():
        for env_dir in sorted(svo_policies.iterdir()):
            if env_dir.is_dir():
                count = len(list(env_dir.glob("svo_angle_*.pkl")))
                status = "✅" if count == 7 else "⚠️ " if count > 0 else "❌"
                print(f"  {status} {env_dir.name:20s}: {count}/7")
    
    # Checkpoints statistics
    print("\n📦 Checkpoints:")
    checkpoints = PROJECT_ROOT / "checkpoints"
    if checkpoints.exists():
        for subdir in ["individual", "maml", "rl2"]:
            subpath = checkpoints / subdir
            if subpath.exists():
                count = len(list(subpath.glob("*.pkl")))
                print(f"  {subdir:15s}: {count} models")
        # Root directory checkpoints
        root_count = len([f for f in checkpoints.glob("*.pkl") if f.is_file()])
        if root_count:
            print(f"  {'(root)':15s}: {root_count} models")
    
    # Running trainings
    print("\n🔄 Running Trainings:")
    result = subprocess.run(
        ["pgrep", "-f", "python.*svo|train_svo"],
        capture_output=True, text=True
    )
    if result.returncode == 0 and result.stdout.strip():
        print("  Training tasks are running")
    else:
        print("  No training tasks running")
    
    print("\n" + "="*60)
    return True


def cmd_list(args):
    """List resources"""
    if args.svo:
        print("\n📁 SVO Policies List:")
        svo_policies = PROJECT_ROOT / "svo-policies"
        if svo_policies.exists():
            for env_dir in sorted(svo_policies.iterdir()):
                if env_dir.is_dir():
                    print(f"\n  {env_dir.name}/")
                    for f in sorted(env_dir.glob("*.pkl")):
                        size = f.stat().st_size / 1024 / 1024
                        print(f"    - {f.name} ({size:.1f} MB)")
    
    elif args.checkpoints:
        print("\n📦 Checkpoints List:")
        checkpoints = PROJECT_ROOT / "checkpoints"
        if checkpoints.exists():
            for f in sorted(checkpoints.rglob("*.pkl")):
                rel_path = f.relative_to(checkpoints)
                size = f.stat().st_size / 1024 / 1024
                print(f"  - {rel_path} ({size:.1f} MB)")
    
    else:
        print("\nSupported Algorithms:")
        for algo, envs in ALGO_ENVS.items():
            print(f"\n  {algo}:")
            print(f"    Environments: {', '.join(envs[:5])}{'...' if len(envs) > 5 else ''}")
        
        print("\n\nSVO Training Environments:")
        for i, env in enumerate(SVO_ENVS):
            print(f"  {i+1:2d}. {env}")
    
    return True


def cmd_clean(args):
    """Clean temporary files"""
    print("\n🧹 Cleaning temporary files...")
    
    # Clean outputs directory
    outputs = PROJECT_ROOT / "outputs"
    if outputs.exists():
        import shutil
        count = sum(1 for _ in outputs.rglob("*") if _.is_file())
        shutil.rmtree(outputs)
        print(f"  ✅ Cleaned outputs/ ({count} files)")
    
    # Clean wandb cache
    wandb = PROJECT_ROOT / "wandb"
    if wandb.exists():
        import shutil
        count = sum(1 for _ in wandb.rglob("*") if _.is_file())
        if count > 100:  # Only clean if significant cache
            shutil.rmtree(wandb)
            print(f"  ✅ Cleaned wandb/ ({count} files)")
        else:
            print(f"  ⏭️  wandb/ has few files ({count}), skipped")
    
    print("\n✅ Cleanup complete")
    return True


def main():
    parser = argparse.ArgumentParser(
        description="SocialMeta Unified Training and Management Tool",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Train SVO policy
  socialmeta-cli train --algo SVO --env cleanup --num-envs 64
  
  # Train IPPO
  socialmeta-cli train --algo IPPO --env coop_mining
  
  # Check status
  socialmeta-cli status
  
  # List all SVO policies
  socialmeta-cli list --svo
        """
    )
    
    subparsers = parser.add_subparsers(dest="command", help="Available commands")
    
    # train command
    train_parser = subparsers.add_parser("train", help="Train models")
    train_parser.add_argument("--algo", required=True, choices=list(ALGO_ENVS.keys()),
                             help="Algorithm name")
    train_parser.add_argument("--env", required=True, help="Environment name")
    train_parser.add_argument("--num-envs", type=int, help="Number of parallel environments")
    train_parser.add_argument("--seed", type=int, default=30, help="Random seed")
    train_parser.add_argument("--wandb", action="store_true", help="Enable W&B logging")
    train_parser.add_argument("--test", action="store_true", help="Test mode (short training)")
    
    # status command
    subparsers.add_parser("status", help="View training status")
    
    # list command
    list_parser = subparsers.add_parser("list", help="List resources")
    list_parser.add_argument("--svo", action="store_true", help="List SVO policies")
    list_parser.add_argument("--checkpoints", action="store_true", help="List checkpoints")
    
    # clean command
    subparsers.add_parser("clean", help="Clean temporary files")
    
    args = parser.parse_args()
    
    if args.command is None:
        parser.print_help()
        return 1
    
    commands = {
        "train": cmd_train,
        "status": cmd_status,
        "list": cmd_list,
        "clean": cmd_clean,
    }
    
    success = commands[args.command](args)
    return 0 if success else 1


if __name__ == "__main__":
    sys.exit(main())
